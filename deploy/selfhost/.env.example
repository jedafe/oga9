OGA9_VERSION=1.0.0
OGA9_DB_PASSWORD=change-me
OGA9_JWT_SECRET=change-me
OGA9_DATA_ENCRYPTION_KEY=
OGA9_BASE_DOMAIN=org.example.com
OGA9_BASE_URL=https://org.example.com
OGA9_APP_URL=https://org.example.com
# upstream proxy CIDRs that may set X-Forwarded-For (rate limits + audit IP)
OGA9_TRUSTED_PROXIES=
OGA9_BIND=127.0.0.1:8080
OGA9_LICENSE_FILE_HOST=./license.json
OGA9_LICENSE_PUBLIC_KEY=
OGA9_LICENSE_OFFLINE_GRACE_DAYS=30
OGA9_SMTP_HOST=
OGA9_SMTP_PORT=25
OGA9_MAIL_FROM=noreply@org.example.com
OGA9_BACKUP_DIR=./backups
OGA9_MIGRATIONS_DIR=./migrations
