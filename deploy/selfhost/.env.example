# OGA9 self-hosted bundle configuration — copy to .env and fill in.
# Ref: oga9-engineering/sections/09-deployment-editions.md
# OGA9_EDITION is pinned to self_hosted by the compose file — do not set.

# REQUIRED — generate strong values (e.g. `openssl rand -hex 32`)
OGA9_JWT_SECRET=
OGA9_DB_PASSWORD=

# Release tag to run (matches `oga9:{version}` in manifest.yaml)
OGA9_VERSION=1.0.0

# Public addressing — set to your real domain in production
OGA9_BASE_DOMAIN=localhost
OGA9_BASE_URL=http://localhost:8080
OGA9_APP_URL=http://localhost:8080
# Loopback by default; TLS terminates upstream (Caddy/nginx)
OGA9_BIND=127.0.0.1:8080
OGA9_TRUSTED_PROXIES=

# Optional: premium license (community install works without it)
# OGA9_LICENSE_FILE_HOST=./license.json
# OGA9_LICENSE_PUBLIC_KEY=
# OGA9_LICENSE_OFFLINE_GRACE_DAYS=30

# Optional: secrets encryption, outbound mail, LiveKit voice
# OGA9_DATA_ENCRYPTION_KEY=
# OGA9_SMTP_HOST=localhost
# OGA9_SMTP_PORT=25
# OGA9_SMTP_USERNAME=
# OGA9_SMTP_PASSWORD=
# OGA9_MAIL_FROM=noreply@localhost
# OGA9_LIVEKIT_URL=
# OGA9_LIVEKIT_API_KEY=
# OGA9_LIVEKIT_API_SECRET=

# Source of migration files (release bundle ships ./migrations;
# repo checkouts can point at db/migrations instead)
# OGA9_MIGRATIONS_DIR=./migrations

# §22 ai-assistant — any OpenAI-compatible /chat/completions endpoint
# (Ollama, vLLM, OpenAI). Unset = ai routes answer 503 ai_unavailable.
# OGA9_AI_PROVIDER_URL=http://ollama:11434/v1/chat/completions
# OGA9_AI_API_KEY=
# OGA9_AI_MODEL=llama3

# Connector file: credential_refs resolve only inside this dir (empty = file: refs rejected)
# OGA9_SECRETS_DIR=/run/secrets
# In-house connector targets (http/private IPs) — leave unset for hosted safety
# OGA9_CONNECTOR_ALLOW_PRIVATE_TARGETS=true
