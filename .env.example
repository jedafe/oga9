OGA9_ENV=development
# Deployment edition: cloud (control+data plane) or self_hosted (data plane only,
# verifies licenses offline, never holds the signing key — §09)
OGA9_EDITION=cloud
OGA9_DATABASE_URL=postgres://oga9:oga9@localhost:5434/oga9?sslmode=disable
OGA9_VALKEY_ADDR=localhost:6379
OGA9_JWT_SECRET=change-me
# 32-byte key for secrets at rest (hex/base64/raw). Dev: derived from JWT secret if unset.
OGA9_DATA_ENCRYPTION_KEY=
OGA9_BASE_DOMAIN=oga9.com
OGA9_CONTROL_HOST=control.oga9.com
OGA9_API_PORT=8080
OGA9_BASE_URL=http://localhost:8080
# User-facing app origin — emailed links + OAuth redirect target (defaults to BASE_URL)
OGA9_APP_URL=http://localhost:3010
OGA9_SESSION_TTL=24h
OGA9_OUTBOX_DISPATCH_INTERVAL=10s
OGA9_EVENTS_RETRY_DEAD_INTERVAL=1m
OGA9_SCHEDULER_TICK_INTERVAL=5m
OGA9_BILLING_SWEEP_INTERVAL=1h
# Self-hosted license signing — ed25519 seed (dev: derived from JWT secret if unset)
OGA9_LICENSE_SIGNING_KEY=
# Billing webhook HMAC secret — provider webhooks rejected while empty
OGA9_BILLING_WEBHOOK_SECRET=
OGA9_SMTP_HOST=localhost
OGA9_SMTP_PORT=1025
# Optional authenticated SMTP (leave empty for Mailpit)
OGA9_SMTP_USERNAME=
OGA9_SMTP_PASSWORD=
OGA9_MAIL_FROM=noreply@oga9.com
OGA9_GLITCHTIP_DSN=
# Comma-separated proxy CIDRs trusted to set X-Forwarded-For
OGA9_TRUSTED_PROXIES=
# OAuth providers activate when id+secret are set:
# OGA9_OAUTH_GOOGLE_CLIENT_ID= / OGA9_OAUTH_GOOGLE_CLIENT_SECRET=
# OGA9_OAUTH_JAPACONNECT_CLIENT_ID= / _CLIENT_SECRET= / _AUTH_URL= / _TOKEN_URL= / _USERINFO_URL=
# Uploads + documents (§14)
OGA9_UPLOADS_DIR=./data/uploads
OGA9_UPLOAD_MAX_MB=0
# Voice rooms (§24 LiveKit — voice disabled while unset)
OGA9_LIVEKIT_URL=
OGA9_LIVEKIT_API_KEY=
OGA9_LIVEKIT_API_SECRET=
OGA9_VOICE_JOIN_WINDOW_SEC=300
OGA9_VOICE_ROOM_MAX_AGE_HOURS=12
# §15 provisioning
OGA9_TRIAL_DAYS=14
# Phased services (full profile):
# OGA9_MEILISEARCH_URL= OGA9_MEILISEARCH_KEY=
# OGA9_S3_ENDPOINT= OGA9_S3_BUCKET= OGA9_S3_ACCESS_KEY= OGA9_S3_SECRET_KEY=
# OGA9_IMGPROXY_URL=

# §22 ai-assistant — OpenAI-compatible /chat/completions endpoint
# (Ollama, vLLM, OpenAI). Unset = ai routes answer 503 ai_unavailable.
OGA9_AI_PROVIDER_URL=
OGA9_AI_API_KEY=
OGA9_AI_MODEL=llama3
# Connector file: credential_refs resolve only inside this dir (empty = file: refs rejected)
OGA9_SECRETS_DIR=
# Self-hosted only: connector locator_url pushes may use http/private hosts
OGA9_CONNECTOR_ALLOW_PRIVATE_TARGETS=
